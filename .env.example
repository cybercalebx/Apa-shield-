# Copy to .env.local and fill in from your Supabase project settings (Settings > API).
# Never commit .env.local or put the service role key in this app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the address shown on the Help & Support page.
VITE_SUPPORT_EMAIL=support@your-domain.com
